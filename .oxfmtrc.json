{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"printWidth": 100,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"semi": true,
	"sortImports": {
		"groups": [
			"builtin",
			"external",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"style",
			"unknown"
		]
	},
	"sortTailwindcss": {
		"attributes": ["className"],
		"functions": ["cn"],
		"stylesheet": "./tooling/tailwind/theme.css"
	},
	"sortPackageJson": true,
	"ignorePatterns": [
		"packages/ai/media/rap-templates/source/effects/templates/bulin-h3-v1.json",
		"packages/ai/media/rap-templates/source/effects/templates/floor58-h3-v1.json",
		"packages/ai/media/rap-templates/source/effects/templates/green-booth-h3-v2.json",
		"packages/ai/media/rap-templates/source/effects/templates/kung-fu-cat-h3-v1.json",
		"packages/ai/media/rap-templates/source/effects/templates/paws-at-you-h3-v1.json",
		"packages/ai/media/rap-templates/source/effects/templates/spin-me-round-v2.json",
		"packages/ai/media/rap-templates/source/rap-prompts/en.json",
		"packages/ai/media/rap-templates/source/rap-prompts/zh.json",
		"packages/ai/media/rap-templates/original-source/spin-me-round-dance-v2.md",
		"apps/workflows/worker-configuration.d.ts",
		"apps/web-host/worker-configuration.d.ts",
		"packages/database/prisma/zod/**.ts",
		"tooling/tailwind/tailwind-animate.css",
		"docs/product/2026-08-23-ezpic-ai-image-editor-spec.md",
		"docs/foundation-repair/2026-08-23/**"
	],
	"overrides": [
		{
			"files": ["**/*.json", "**/*.jsonc"],
			"options": {
				"trailingComma": "none"
			}
		}
	]
}
