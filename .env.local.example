GUEST_PROMOTION_PERIOD=""
GUEST_ABUSE_HMAC_VERSION=""
GUEST_ABUSE_HMAC_SECRET=""
NEXT_PUBLIC_GUEST_TURNSTILE_SITE_KEY=""
GUEST_TURNSTILE_SECRET_KEY=""
GUEST_RISK_BUDGET_MICROS=""

# Non-secret identifiers and aggregate values for production certification. Keep blank until
# the corresponding real staging evidence has been reviewed; blank remains NOT_COMPLETED.
# The billed-cost record is valid only for the exact guest product/SKU pair advertised at runtime.
GUEST_BILLED_SKU_COST_EVIDENCE_ID=""
GUEST_BILLED_SKU_COST_MICROS=""
GUEST_BILLED_SKU_PRODUCT_KEY=""
GUEST_BILLED_SKU_KEY=""
