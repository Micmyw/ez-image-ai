# Runtime and feature gates
NODE_ENV="development"
# Required as staging or production only in production-mode deployments.
EZPIC_DEPLOYMENT_ENVIRONMENT=""
EZPIC_ENVIRONMENT_ID=""
MEDIA_GENERATION_ENABLED="false"
MEDIA_STANDARD_EDIT_ENABLED="false"
MEDIA_QUALITY_EDIT_ENABLED="false"
LEGACY_AI_STREAM_ENABLED="false"
MEDIA_MODERATION_ENABLED="false"
BILLING_ENABLED="false"
ERROR_MONITORING_ENABLED="false"
DEPLOYMENT_VERSION="local"
MEDIA_DAILY_PROVIDER_COST_BUDGET_MICROS=""
MEDIA_ALERT_ERROR_RATE_BPS=""
MEDIA_ALERT_P95_LATENCY_MS=""
MEDIA_ALERT_MODERATION_REJECTION_RATE_BPS=""
MEDIA_ALERT_CHANNEL_ID=""

# PostgreSQL. TEST_DATABASE_URL is intentionally a separate, disposable database.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ezpic"
TEST_DATABASE_URL="postgresql://ezpic_test:ezpic_test_only@127.0.0.1:55432/ezpic_testing"
DIRECT_URL=""
# Non-secret resource name used only for isolation/certification evidence.
EZPIC_DATABASE_RESOURCE_ID=""

# Unified public/product origin. Keep the legacy marketing alias identical.
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
NEXT_PUBLIC_SAAS_URL="http://localhost:3000"
NEXT_PUBLIC_DOCS_URL="http://localhost:3002"
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SITE_NAME="EzPic"
NEXT_PUBLIC_SITE_DESCRIPTION="Private prompt-based AI image editing with transparent credits."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
EZPIC_GSC_PROPERTY=""

# Authentication
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email
MAIL_FROM="EzPic <noreply@localhost.invalid>"
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Resend
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
EZPIC_MAIL_PROVIDER_ID=""

# Payment providers. The AI media foundation uses Stripe subscription billing by default.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
EZPIC_STRIPE_WEBHOOK_SCOPE_ID=""
# PayPal REST subscriptions. Use sandbox locally/staging and live only in production.
PAYPAL_ENVIRONMENT=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Waffo Pancake Merchant of Record. Use test locally/staging and prod only in production.
WAFFO_ENVIRONMENT=""
WAFFO_MERCHANT_ID=""
WAFFO_PRIVATE_KEY=""
WAFFO_WEBHOOK_PUBLIC_KEY=""
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_SECRET=""
# Paid checkout fails closed when any selected interval is blank or is not a real Stripe price_ ID.
# Keep these server-only; never rename them with NEXT_PUBLIC_ or commit account-specific values.
PRICE_ID_CREATOR_MONTHLY=""
PRICE_ID_CREATOR_YEARLY=""
PRICE_ID_STUDIO_MONTHLY=""
PRICE_ID_STUDIO_YEARLY=""
# PayPal/Waffo intervals are advertised only when the matching server-only ID and BillingPlan exist.
PAYPAL_PLAN_ID_CREATOR_MONTHLY=""
PAYPAL_PLAN_ID_CREATOR_YEARLY=""
PAYPAL_PLAN_ID_STUDIO_MONTHLY=""
PAYPAL_PLAN_ID_STUDIO_YEARLY=""
WAFFO_PRODUCT_ID_CREATOR_MONTHLY=""
WAFFO_PRODUCT_ID_CREATOR_YEARLY=""
WAFFO_PRODUCT_ID_STUDIO_MONTHLY=""
WAFFO_PRODUCT_ID_STUDIO_YEARLY=""

# Private S3/R2-compatible media storage. MEDIA_BUCKET_NAME is the only media bucket key.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="auto"
MEDIA_BUCKET_NAME="media-private"
EZPIC_MEDIA_BUCKET_RESOURCE_ID=""
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"

# Trigger.dev
TRIGGER_PROJECT_REF=""
TRIGGER_SECRET_KEY=""
EZPIC_TRIGGER_ENVIRONMENT_ID=""

# Provider routing and credentials. mock is development/test only when the shared list is absent.
# Comma-separated real routes shared by web/API and workers. Worker credentials only
# make configured routes locally executable; credentials never enable a route by themselves.
MEDIA_ENABLED_PROVIDERS=""
MEDIA_OPENROUTER_IMAGE_ROUTES_CERTIFIED="false"
# Optional worker-only drain list for callbacks/reconciliation of already accepted tasks.
# Providers here never accept new submissions unless also listed above.
MEDIA_RECOVERY_PROVIDERS=""
# Legacy single-route selector; ignored when MEDIA_ENABLED_PROVIDERS is set.
MEDIA_PROVIDER_ADAPTER="mock"
REPLICATE_API_TOKEN=""
REPLICATE_WEBHOOK_SECRET=""
FAL_API_KEY=""
KIE_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
MEDIA_REMOTE_ALLOWED_HOSTS=""
KIE_OUTPUT_HOSTS=""

# Moderation. test is development/test only.
MEDIA_SAFETY_ADAPTER="test"
MEDIA_ALLOW_TEST_SAFETY_ADAPTER="true"
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""

# Error monitoring
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
EZPIC_SENTRY_ENVIRONMENT=""

# Queue controls and runtime kill switches
MEDIA_IMAGE_SUBMISSION_CONCURRENCY="4"
MEDIA_VIDEO_SUBMISSION_CONCURRENCY="2"
MEDIA_FINALIZATION_CONCURRENCY="3"
MEDIA_RECOVERY_CONCURRENCY="2"
MEDIA_PROVIDER_QUEUE_LIMITS="replicate=20,fal=20,kie=5,gemini=10,openrouter=2"
MEDIA_MODEL_QUEUE_LIMITS=""
MEDIA_MAX_ACTIVE_UPLOAD_SESSIONS="5"
MEDIA_MAX_STORAGE_BYTES="2147483648"
MEDIA_TRUSTED_PROXY_PROVIDER=""
MEDIA_MAX_ACTIVE_ANONYMOUS_DRAFTS="3"
MEDIA_MAX_ANONYMOUS_DRAFT_BYTES="26214400"
MEDIA_MAX_GLOBAL_ANONYMOUS_DRAFTS_PER_MINUTE="100"

# Analytics
NEXT_PUBLIC_PIRSCH_CODE=""
NEXT_PUBLIC_PLAUSIBLE_URL=""
NEXT_PUBLIC_MIXPANEL_TOKEN=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
EZPIC_POSTHOG_PROJECT_ID=""
NEXT_PUBLIC_UMAMI_TRACKING_ID=""

# Local mock E2E (never enable in production)
E2E_TEST_MEDIA_ADAPTERS="false"
E2E_DRAFT_HANDOFF="false"
E2E_USER_PASSWORD=""
E2E_RUN_ID=""
E2E_USE_PRODUCTION_BUILD="false"

# Load testing safety gates
LOAD_BASE_URL="http://127.0.0.1:3000"
LOAD_MARKETING_PATH="/"
LOAD_ENDPOINT="/api/testing/media-load"
LOAD_LOCAL_QUOTE_CREATE_PATH="/api/testing/media-load"
LOAD_PROFILE="smoke"
LOAD_SCENARIOS="marketing,upload-concurrency,quote-create,polling,signed-url,admin-aggregate"
# Request paths are origin-relative only. Fixture bodies and identifiers are protected inputs;
# never place their values in committed evidence or logs.
LOAD_UPLOAD_PATH="/api/media/upload-sessions"
LOAD_UPLOAD_ABORT_PATH_TEMPLATE="/api/media/upload-sessions/{sessionId}/abort"
LOAD_UPLOAD_BODY=""
LOAD_QUOTE_PATH="/api/media/quotes"
LOAD_QUOTE_BODY=""
LOAD_CREATE_PATH="/api/media/generations"
LOAD_CREATE_BODY=""
LOAD_POLL_PATH_TEMPLATE="/api/media/jobs/{jobId}"
LOAD_POLL_JOB_ID=""
LOAD_SIGNED_URL_PATH_TEMPLATE="/api/media/assets/{assetId}/access"
LOAD_SIGNED_URL_ASSET_ID=""
LOAD_ADMIN_AGGREGATE_PATH="/api/admin/media/growth-operations"
LOAD_AUTH_TOKEN=""
LOAD_USER_SESSION_COOKIE=""
LOAD_ADMIN_SESSION_COOKIE=""
LOAD_TEST_DATABASE_URL=""
LOAD_TEST_RUN_ID=""
LOAD_EXECUTION_CONFIRMATION=""
LOAD_MAX_REQUESTS="120"
LOAD_MAX_ERROR_RATE_BPS="100"
LOAD_MARKETING_P95_MS="1000"
LOAD_UPLOAD_P95_MS="2000"
LOAD_QUOTE_CREATE_P95_MS="1500"
LOAD_POLLING_P95_MS="800"
LOAD_SIGNED_URL_P95_MS="800"
LOAD_ADMIN_AGGREGATE_P95_MS="2000"
LOAD_PROVIDER_CALLS_ENABLED="false"
LOAD_PROVIDER_COST_PER_CREATE_MICROS="0"
LOAD_MAX_EXPECTED_PROVIDER_COST_MICROS="0"
LOAD_PROVIDER_SPEND_CONFIRMATION=""
LOAD_TEST_RATE_LIMIT_PER_MINUTE="600"
LOAD_TEST_CONCURRENCY_LIMIT="64"
LOAD_TEST_CREDIT_GRANT="100000"
LOAD_TEST_REMOTE_DATABASE_ENABLED="false"
LOAD_TEST_DATABASE_NAME_CONFIRMATION=""
ALLOW_REMOTE_LOAD_TARGET="false"
LOAD_REMOTE_TARGET_ALLOWLIST=""
LOAD_TARGET_CONFIRMATION=""
LOAD_TARGET_ENVIRONMENT="local"
LOAD_TARGET_ENVIRONMENT_CONFIRMATION=""
INVARIANT_JOB_PREFIX="k6:"
REQUIRE_LOAD_SAMPLE="false"

# Protected launch evidence paths. The committed defaults remain NOT_COMPLETED.
EZPIC_ENVIRONMENT_MATRIX_PATH="docs/operations/evidence/ezpic-environment-matrix.template.json"
EZPIC_LAUNCH_EVIDENCE_PATH="docs/operations/evidence/ezpic-staging-evidence.json"

# Real-provider smoke safety gates. CI uses protected environment values.
PROVIDER_SMOKE_ALLOWLIST="image-fast:replicate"
PROVIDER_SMOKE_ENABLED_TIERS="image-fast"
PROVIDER_SMOKE_MAX_INVOCATIONS="1"
PROVIDER_SMOKE_MAX_EXPECTED_COST_MICROS="10000"
PROVIDER_SMOKE_PROMPT="A small blue circle on a plain white background"
PROVIDER_SMOKE_CONFIRM_LIVE="false"

# The committed image-edit manifest contains placeholders only. Live mode also requires explicit
# CLI confirmation, a positive maximum budget, authorized private assets, Provider credentials,
# and an executor bound to the existing private generation/finalization pipeline.
IMAGE_EDIT_BENCHMARK_MANIFEST="fixtures/image-edit-benchmark/manifest.json"
