datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  isAnonymous              Boolean                      @default(false)
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]
  guestSessionBootstraps   GuestSessionBootstrap[]      @relation("GuestBootstrapOwner")
  guestMediaTrials         GuestMediaTrial[]            @relation("GuestTrialOwner")
  guestLinkRegistrations   GuestLinkIntent[]            @relation("GuestLinkRegisteredUser")
  guestResultGrants        GuestResultAccessGrant[]     @relation("GuestGrantRegisteredUser")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id                String        @id @default(cuid())
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String?
  type              PurchaseType
  customerId        String
  subscriptionId    String?       @unique
  priceId           String
  status            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  mediaSubscription Subscription?

  @@index([subscriptionId])
  @@map("purchase")
}

enum OwnerType {
  USER
  ORGANIZATION
}

enum GenerationJobStatus {
  RESERVED
  DISPATCH_QUEUED
  SUBMITTING
  PROVIDER_PENDING
  PROVIDER_RUNNING
  NEEDS_RECONCILIATION
  FINALIZING
  SUCCEEDED
  FAILED
  CANCELED
}

enum GenerationServiceClass {
  STANDARD
  GUEST_SLOW
}

enum GenerationAttemptStatus {
  CREATED
  SUBMISSION_UNCERTAIN
  SUBMITTED
  RUNNING
  NEEDS_RECONCILIATION
  SUCCEEDED
  FAILED
  CANCELED
}

enum MediaAssetStatus {
  UPLOADING
  VERIFYING
  VERIFICATION_FAILED
  READY
  QUARANTINED
  DELETED
}

enum GenerationRetryRequestStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum MediaAssetKind {
  INPUT
  OUTPUT
}

enum MediaRetentionClass {
  ACCOUNT
  GUEST_TRIAL
}

enum GuestTrialEligibility {
  AVAILABLE
  IN_FLIGHT
  CONSUMED
  EXPIRED
}

enum GuestLinkState {
  NONE
  LINKING
  LINKED
}

enum GenerationJobAssetRole {
  INPUT
  OUTPUT
}

enum UploadSessionStatus {
  PENDING
  FINALIZING
  COMPLETED
  EXPIRED
  ABORTED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REVIEW
  ERROR
}

enum StorageReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum CreditReservationStatus {
  ACTIVE
  SETTLED
  RELEASED
}

enum CreditLedgerEntryType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
  EXPIRE
  REFUND
  DEBT_REPAYMENT
  DEBT_INCURRED
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DEAD_LETTER
}

enum OutboxEventStatus {
  PENDING
  LEASED
  PROCESSED
  DEAD_LETTER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingPeriodStatus {
  PENDING
  ACTIVE
  CLOSED
  VOID
  REFUNDED
}

enum StripeRefundStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
}

enum StripeRefundRepairAction {
  CONFIRM_SUCCEEDED
  COMPENSATE_FAILED_OR_CANCELED
}

enum StripeReconciliationStatus {
  IDLE
  RUNNING
}

enum StripeReconciliationStage {
  SUBSCRIPTIONS
  INVOICES
  REFUNDS
}

enum StripeReconciliationIssueStatus {
  OPEN
  RESOLVED
}

enum GenerationDraftStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
}

model GenerationQuote {
  id                    String                  @id @default(cuid())
  ownerType             OwnerType
  ownerId               String
  submittedByUserId     String
  productKey            String
  catalogVersion        String
  pricingVersion        String
  credits               BigInt
  costMicros            BigInt
  inputSnapshot         Json
  pricingSnapshot       Json
  moderationDecision    String                  @default("LEGACY_UNREVIEWED")
  moderationProvider    String                  @default("legacy")
  moderationRuleVersion String                  @default("legacy")
  moderationReasonCode  String                  @default("LEGACY_UNREVIEWED")
  inputFingerprint      String                  @default("")
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  expiresAt             DateTime                @db.Timestamptz(3)
  job                   GenerationJob?
  retryRequest          GenerationRetryRequest? @relation("GenerationRetryQuote")

  @@index([ownerType, ownerId, createdAt, id])
  @@index([expiresAt])
  @@map("generation_quote")
}

model GenerationJob {
  id                     String                   @id @default(cuid())
  ownerType              OwnerType
  ownerId                String
  submittedByUserId      String
  quoteId                String                   @unique
  quote                  GenerationQuote          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  idempotencyKey         String
  productKey             String
  catalogVersion         String
  pricingVersion         String
  creditsReserved        BigInt
  inputSnapshot          Json
  pricingSnapshot        Json
  status                 GenerationJobStatus      @default(RESERVED)
  serviceClass           GenerationServiceClass   @default(STANDARD)
  dispatchEligibleAt     DateTime?                @db.Timestamptz(3)
  guestTrialId           String?
  guestTrial             GuestMediaTrial?         @relation("GuestTrialJobs", fields: [guestTrialId], references: [id], onDelete: SetNull)
  currentForGuestTrial   GuestMediaTrial?         @relation("GuestTrialCurrentJob")
  consumedForGuestTrial  GuestMediaTrial?         @relation("GuestTrialConsumedJob")
  guestResultGrants      GuestResultAccessGrant[]
  version                Int                      @default(0)
  failureCode            String?
  failureMessage         String?
  finalizationStage      String?
  finalizationRetryCount Int                      @default(0)
  finalizationErrorCode  String?
  nextFinalizeAt         DateTime?                @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  terminalAt             DateTime?                @db.Timestamptz(3)
  reservation            CreditReservation?
  attempts               GenerationAttempt[]
  assets                 GenerationJobAsset[]
  retrySourceRequests    GenerationRetryRequest[] @relation("GenerationRetrySourceJob")
  retryResultRequest     GenerationRetryRequest?  @relation("GenerationRetryResultJob")
  editSessionId          String?
  editSession            ImageEditSession?        @relation(fields: [editSessionId], references: [id], onDelete: SetNull)
  parentJobId            String?
  parentJob              GenerationJob?           @relation("ImageEditParent", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs              GenerationJob[]          @relation("ImageEditParent")

  @@unique([ownerType, ownerId, idempotencyKey])
  @@index([ownerType, ownerId, createdAt, id])
  @@index([status, updatedAt])
  @@index([status, nextFinalizeAt])
  @@index([editSessionId, createdAt, id])
  @@index([parentJobId])
  @@index([serviceClass, dispatchEligibleAt, status])
  @@index([guestTrialId, createdAt, id])
  @@map("generation_job")
}

model ImageEditSession {
  id          String          @id @default(cuid())
  ownerType   OwnerType
  ownerId     String
  rootAssetId String
  title       String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  jobs        GenerationJob[]

  @@index([ownerType, ownerId, updatedAt, id])
  @@index([rootAssetId])
  @@map("image_edit_session")
}

model GenerationAttempt {
  id                     String                  @id @default(cuid())
  jobId                  String
  job                    GenerationJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber          Int
  provider               String
  providerModelId        String
  providerTaskId         String?
  providerStatusUrl      String?
  providerResultUrl      String?
  submissionToken        String?
  status                 GenerationAttemptStatus @default(CREATED)
  providerCostMicros     BigInt?
  progress               Int?
  lastProviderEventAt    DateTime?               @db.Timestamptz(3)
  lastProviderOccurredAt DateTime?               @db.Timestamptz(3)
  lastProviderReceivedAt DateTime?               @db.Timestamptz(3)
  lastProviderSequence   BigInt?
  uncertainSubmission    Boolean                 @default(false)
  reconciliationCount    Int                     @default(0)
  nextReconcileAt        DateTime?               @db.Timestamptz(3)
  reconcileLeaseToken    String?                 @unique
  reconcileLeasedUntil   DateTime?               @db.Timestamptz(3)
  requestSnapshot        Json
  responseSnapshot       Json?
  errorSnapshot          Json?
  transferEnvelope       GenerationAttemptTransferEnvelope?
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  submittedAt            DateTime?               @db.Timestamptz(3)
  completedAt            DateTime?               @db.Timestamptz(3)

  @@unique([jobId, attemptNumber])
  @@unique([provider, providerTaskId])
  @@index([status, updatedAt])
  @@index([status, nextReconcileAt, updatedAt])
  @@map("generation_attempt")
}

model GenerationAttemptTransferEnvelope {
  attemptId String            @id
  attempt   GenerationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@map("generation_attempt_transfer_envelope")
}

model MediaAsset {
  id                               String                  @id @default(cuid())
  ownerType                        OwnerType
  ownerId                          String
  kind                             MediaAssetKind
  status                           MediaAssetStatus        @default(UPLOADING)
  retentionClass                   MediaRetentionClass     @default(ACCOUNT)
  deleteAfter                      DateTime?               @db.Timestamptz(3)
  watermarkVersion                 String?
  watermarkedAt                    DateTime?               @db.Timestamptz(3)
  cleanStagingDeletedAt            DateTime?               @db.Timestamptz(3)
  objectKey                        String                  @unique
  mimeType                         String
  byteSize                         BigInt
  width                            Int?
  height                           Int?
  durationMillis                   BigInt?
  checksum                         String?
  storageEtag                      String?
  storageVersionId                 String?
  finalizedAt                      DateTime?               @db.Timestamptz(3)
  outputTransferToken              String?                 @unique
  outputTransferLeaseExpiresAt     DateTime?               @db.Timestamptz(3)
  outputStagingObjectKey           String?                 @unique
  outputPromotionMultipartUploadId String?
  sourceUrl                        String?
  verificationGeneration           Int                     @default(0)
  verificationAttemptCount         Int                     @default(0)
  verificationProvider             String?
  verificationRuleVersion          String?
  verificationPolicyVersion        String?
  verificationProviderTaskId       String?
  verificationLeaseToken           String?                 @unique
  verificationLeasedUntil          DateTime?               @db.Timestamptz(3)
  verificationNextAttemptAt        DateTime?               @db.Timestamptz(3)
  verificationDeadlineAt           DateTime?               @db.Timestamptz(3)
  verificationExhaustedAt          DateTime?               @db.Timestamptz(3)
  verificationValidUntil           DateTime?               @db.Timestamptz(3)
  verificationSubmissionToken      String?                 @unique
  verificationSubmissionUncertain  Boolean                 @default(false)
  verificationSubmittedAt          DateTime?               @db.Timestamptz(3)
  verificationLastErrorCode        String?
  createdAt                        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt                        DateTime?               @db.Timestamptz(3)
  uploadSessions                   MediaUploadSession[]
  jobBindings                      GenerationJobAsset[]
  moderationResults                AssetModerationResult[]
  guestBootstrapSources            GuestSessionBootstrap[] @relation("GuestBootstrapSourceAsset")
  guestTrialSources                GuestMediaTrial[]       @relation("GuestTrialSourceAsset")

  @@index([ownerType, ownerId, createdAt, id])
  @@index([status, createdAt])
  @@index([status, verificationNextAttemptAt, verificationLeasedUntil], map: "media_asset_verification_recovery_idx")
  @@index([status, verificationDeadlineAt, verificationLeasedUntil], map: "media_asset_video_verification_recovery_idx")
  @@index([status, verificationValidUntil], map: "media_asset_ready_expiry_idx")
  @@index([outputTransferLeaseExpiresAt])
  @@index([outputPromotionMultipartUploadId])
  @@index([retentionClass, deleteAfter])
  @@map("media_asset")
}

model MediaUploadSession {
  id                         String              @id @default(cuid())
  assetId                    String
  asset                      MediaAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tokenHash                  String              @unique
  multipartUploadId          String?
  stagingObjectKey           String?             @unique
  stagedTerminalizationToken String?
  promotionMultipartUploadId String?
  promotionToken             String?
  finalizationToken          String?             @unique
  finalizationLeaseExpiresAt DateTime?           @db.Timestamptz(3)
  legacyFinalizationToken    String?
  finalizationParts          Json?
  status                     UploadSessionStatus @default(PENDING)
  expectedBytes              BigInt
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  expiresAt                  DateTime            @db.Timestamptz(3)
  completedAt                DateTime?           @db.Timestamptz(3)
  guestCapabilityVersion     String?
  guestOriginHash            String?
  guestExpectedSha256        String?
  guestCompletionConsumedAt  DateTime?           @db.Timestamptz(3)

  @@index([status, expiresAt])
  @@index([status, finalizationLeaseExpiresAt])
  @@index([promotionMultipartUploadId])
  @@index([promotionToken])
  @@map("media_upload_session")
}

model GenerationJobAsset {
  id            String                 @id @default(cuid())
  jobId         String
  job           GenerationJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assetId       String
  asset         MediaAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetChecksum String
  role          GenerationJobAssetRole
  position      Int                    @default(0)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)

  @@unique([jobId, assetId, role])
  @@index([assetId])
  @@map("generation_job_asset")
}

model AssetModerationResult {
  id                     String           @id @default(cuid())
  assetId                String
  asset                  MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetChecksum          String?
  verificationGeneration Int
  attemptNumber          Int
  evidenceKind           MediaAssetKind
  provider               String
  providerTaskId         String?
  ruleVersion            String
  policyVersion          String
  status                 ModerationStatus
  reasonCode             String
  categories             Json
  rawEnvelope            Json
  validUntil             DateTime?        @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([assetId, verificationGeneration, attemptNumber], map: "asset_moderation_result_generation_attempt_key")
  @@index([assetId, assetChecksum, verificationGeneration, status], map: "asset_moderation_result_authorization_idx")
  @@index([status, createdAt])
  @@map("asset_moderation_result")
}

model GenerationRetryRequest {
  id                   String                       @id @default(cuid())
  ownerType            OwnerType
  ownerId              String
  submittedByUserId    String
  sourceJobId          String
  sourceJob            GenerationJob                @relation("GenerationRetrySourceJob", fields: [sourceJobId], references: [id], onDelete: Restrict)
  resultJobId          String?                      @unique
  resultJob            GenerationJob?               @relation("GenerationRetryResultJob", fields: [resultJobId], references: [id], onDelete: Restrict)
  quoteId              String?                      @unique
  quote                GenerationQuote?             @relation("GenerationRetryQuote", fields: [quoteId], references: [id], onDelete: Restrict)
  idempotencyKey       String
  status               GenerationRetryRequestStatus @default(PROCESSING)
  operationFingerprint String
  operationSnapshot    Json
  leaseToken           String?                      @unique
  leasedUntil          DateTime?                    @db.Timestamptz(3)
  errorCode            String?
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  completedAt          DateTime?                    @db.Timestamptz(3)

  @@unique([ownerType, ownerId, idempotencyKey])
  @@index([sourceJobId, createdAt])
  @@index([status, leasedUntil])
  @@map("generation_retry_request")
}

model StorageUsageReservation {
  id           String                   @id @default(cuid())
  ownerType    OwnerType
  ownerId      String
  bytes        BigInt
  status       StorageReservationStatus @default(ACTIVE)
  referenceKey String                   @unique
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime                 @db.Timestamptz(3)
  releasedAt   DateTime?                @db.Timestamptz(3)

  @@index([ownerType, ownerId, status])
  @@index([status, expiresAt])
  @@map("storage_usage_reservation")
}

model CreditAccount {
  id               String              @id @default(cuid())
  ownerType        OwnerType
  ownerId          String
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  spendableCredits BigInt              @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  reservedCredits  BigInt              @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  creditDebt       BigInt              @default(0)
  version          Int                 @default(0)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  lots             CreditLot[]
  reservations     CreditReservation[]
  ledgerEntries    CreditLedgerEntry[]

  @@unique([ownerType, ownerId])
  @@map("credit_account")
}

model CreditLot {
  id                      String                        @id @default(cuid())
  accountId               String
  account                 CreditAccount                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  grantReferenceKey       String
  grantedAmount           BigInt
  remainingAmount         BigInt
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  expiredUnrefundedAmount BigInt                        @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  reservedAmount          BigInt                        @default(0)
  expiresAt               DateTime?                     @db.Timestamptz(3)
  createdAt               DateTime                      @default(now()) @db.Timestamptz(3)
  allocations             CreditReservationAllocation[]

  @@unique([accountId, grantReferenceKey])
  @@index([accountId, expiresAt, createdAt, id])
  @@map("credit_lot")
}

model CreditReservation {
  id             String                        @id @default(cuid())
  accountId      String
  account        CreditAccount                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  jobId          String                        @unique
  job            GenerationJob                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  amount         BigInt
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  settledAmount  BigInt                        @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  releasedAmount BigInt                        @default(0)
  status         CreditReservationStatus       @default(ACTIVE)
  createdAt      DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                      @updatedAt @db.Timestamptz(3)
  allocations    CreditReservationAllocation[]

  @@index([accountId, status, createdAt])
  @@map("credit_reservation")
}

model CreditReservationAllocation {
  id                    String            @id @default(cuid())
  reservationId         String
  reservation           CreditReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  lotId                 String
  lot                   CreditLot         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  amount                BigInt
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  settledAmount         BigInt            @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  releasedAmount        BigInt            @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  revokedAmount         BigInt            @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  revokedSettledAmount  BigInt            @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  revokedReleasedAmount BigInt            @default(0)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([reservationId, lotId])
  @@index([lotId])
  @@map("credit_reservation_allocation")
}

model CreditLedgerEntry {
  id            String                @id @default(cuid())
  accountId     String
  account       CreditAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lotId         String?
  reservationId String?
  type          CreditLedgerEntryType
  amount        BigInt
  referenceKey  String                @unique
  metadata      Json
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  @@index([accountId, createdAt, id])
  @@index([reservationId])
  @@map("credit_ledger_entry")
}

model ProviderWebhookEvent {
  id                    String                @id @default(cuid())
  provider              String
  providerEventId       String
  providerTaskId        String?
  verifiedAt            DateTime              @db.Timestamptz(3)
  receivedAt            DateTime              @default(now()) @db.Timestamptz(3)
  providerOccurredAt    DateTime?             @db.Timestamptz(3)
  providerSequence      BigInt?
  envelope              Json
  status                EventProcessingStatus @default(RECEIVED)
  processedAt           DateTime?             @db.Timestamptz(3)
  failureReason         String?
  processingToken       String?               @unique
  processingLeasedUntil DateTime?             @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([processingLeasedUntil])
  @@map("provider_webhook_event")
}

model OutboxEvent {
  id                String            @id @default(cuid())
  eventType         String
  aggregateType     String
  aggregateId       String
  dedupeKey         String            @unique
  payload           Json
  status            OutboxEventStatus @default(PENDING)
  attempts          Int               @default(0)
  availableAt       DateTime          @default(now()) @db.Timestamptz(3)
  leaseOwner        String?
  leaseToken        String?           @unique
  leasedUntil       DateTime?         @db.Timestamptz(3)
  processedAt       DateTime?         @db.Timestamptz(3)
  lastError         String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  guestCleanupTrial GuestMediaTrial?  @relation("GuestTrialCleanupOutbox")

  @@index([status, availableAt, createdAt])
  @@index([leasedUntil])
  @@map("outbox_event")
}

model GuestSessionBootstrap {
  id              String           @id @default(cuid())
  ownerId         String?
  owner           User?            @relation("GuestBootstrapOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  promotionPeriod String
  claimHash       String           @unique
  idempotencyKey  String           @unique
  claimedDraftId  String?          @unique
  claimedDraft    GenerationDraft? @relation(fields: [claimedDraftId], references: [id], onDelete: SetNull)
  sourceAssetId   String?          @unique
  sourceAsset     MediaAsset?      @relation("GuestBootstrapSourceAsset", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime         @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)

  @@unique([ownerId, promotionPeriod])
  @@index([expiresAt])
  @@map("guest_session_bootstrap")
}

model GuestMediaTrial {
  id                   String                   @id @default(cuid())
  ownerId              String
  owner                User                     @relation("GuestTrialOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  promotionPeriod      String
  eligibility          GuestTrialEligibility    @default(AVAILABLE)
  sponsorCredits       BigInt                   @default(4)
  sourceAssetId        String?
  sourceAsset          MediaAsset?              @relation("GuestTrialSourceAsset", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  currentJobId         String?                  @unique
  currentJob           GenerationJob?           @relation("GuestTrialCurrentJob", fields: [currentJobId], references: [id], onDelete: SetNull)
  consumedJobId        String?                  @unique
  consumedJob          GenerationJob?           @relation("GuestTrialConsumedJob", fields: [consumedJobId], references: [id], onDelete: Restrict)
  cleanupOutboxEventId String?                  @unique
  cleanupOutboxEvent   OutboxEvent?             @relation("GuestTrialCleanupOutbox", fields: [cleanupOutboxEventId], references: [id], onDelete: SetNull)
  jobs                 GenerationJob[]          @relation("GuestTrialJobs")
  linkIntents          GuestLinkIntent[]
  resultAccessGrants   GuestResultAccessGrant[]
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  consumedAt           DateTime?                @db.Timestamptz(3)
  expiresAt            DateTime                 @db.Timestamptz(3)

  @@unique([ownerId, promotionPeriod])
  @@index([eligibility, expiresAt])
  @@index([sourceAssetId])
  @@map("guest_media_trial")
}

model GuestLinkIntent {
  id               String          @id @default(cuid())
  trialId          String
  trial            GuestMediaTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  state            GuestLinkState  @default(NONE)
  tokenHash        String          @unique
  idempotencyKey   String          @unique
  registeredUserId String?
  registeredUser   User?           @relation("GuestLinkRegisteredUser", fields: [registeredUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime        @db.Timestamptz(3)
  linkedAt         DateTime?       @db.Timestamptz(3)

  @@index([trialId, state, createdAt])
  @@index([registeredUserId])
  @@map("guest_link_intent")
}

model GuestResultAccessGrant {
  id               String          @id @default(cuid())
  trialId          String
  trial            GuestMediaTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)
  guestJobId       String
  guestJob         GenerationJob   @relation(fields: [guestJobId], references: [id], onDelete: Restrict)
  registeredUserId String
  registeredUser   User            @relation("GuestGrantRegisteredUser", fields: [registeredUserId], references: [id], onDelete: Cascade)
  grantTokenHash   String          @unique
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime        @db.Timestamptz(3)
  consumedAt       DateTime?       @db.Timestamptz(3)

  @@unique([guestJobId, registeredUserId])
  @@index([trialId, expiresAt])
  @@index([registeredUserId])
  @@map("guest_result_access_grant")
}

model GuestAbuseBucket {
  id             String    @id @default(cuid())
  scope          String
  subjectHash    String
  windowStart    DateTime  @db.Timestamptz(3)
  windowEnd      DateTime  @db.Timestamptz(3)
  requestCount   BigInt    @default(0)
  rejectionCount BigInt    @default(0)
  blockedUntil   DateTime? @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  version        Int       @default(0)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([scope, subjectHash, windowStart])
  @@index([expiresAt])
  @@index([blockedUntil])
  @@map("guest_abuse_bucket")
}

model GuestRiskBudgetBucket {
  id              String   @id @default(cuid())
  promotionPeriod String
  subjectHash     String
  reservedMicros  BigInt   @default(0)
  consumedMicros  BigInt   @default(0)
  hardLimitMicros BigInt
  expiresAt       DateTime @db.Timestamptz(3)
  version         Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([promotionPeriod, subjectHash])
  @@index([expiresAt])
  @@map("guest_risk_budget_bucket")
}

model BillingPlan {
  id               String         @id @default(cuid())
  provider         String
  providerPriceId  String
  name             String
  creditsPerPeriod BigInt
  priceMicros      BigInt
  currency         String
  active           Boolean        @default(true)
  version          Int            @default(1)
  metadata         Json
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  subscriptions    Subscription[]

  @@unique([provider, providerPriceId])
  @@map("billing_plan")
}

model Subscription {
  id                               String             @id @default(cuid())
  ownerType                        OwnerType
  ownerId                          String
  provider                         String
  providerSubscriptionId           String             @unique
  planId                           String
  plan                             BillingPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  purchaseId                       String?            @unique
  purchase                         Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  status                           SubscriptionStatus
  currentPeriodStart               DateTime?          @db.Timestamptz(3)
  currentPeriodEnd                 DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd                Boolean            @default(false)
  scheduledPlanId                  String?
  lastProviderEventAt              DateTime?          @db.Timestamptz(3)
  lastProviderEventId              String?
  lastReconciliationSweepId        String?
  lastReconciliationAppliedSweepId String?
  lastReconciledAt                 DateTime?          @db.Timestamptz(3)
  graceEndsAt                      DateTime?          @db.Timestamptz(3)
  createdAt                        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime           @updatedAt @db.Timestamptz(3)
  periods                          BillingPeriod[]

  @@index([ownerType, ownerId, status])
  @@index([provider, status, createdAt])
  @@index([provider, lastReconciliationAppliedSweepId, status], map: "subscription_provider_reconcile_sweep_status_idx")
  @@map("subscription")
}

model BillingPeriod {
  id                       String              @id @default(cuid())
  subscriptionId           String
  subscription             Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  startsAt                 DateTime            @db.Timestamptz(3)
  endsAt                   DateTime            @db.Timestamptz(3)
  status                   BillingPeriodStatus @default(PENDING)
  creditAmount             BigInt
  grantReferenceKey        String?             @unique
  providerInvoiceId        String?
  providerInvoicePaymentId String?
  providerChargeId         String?
  providerPaymentIntentId  String?
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  paidAmount               BigInt              @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  refundedAmount           BigInt              @default(0)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  refundedCredits          BigInt              @default(0)
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([subscriptionId, startsAt])
  @@index([providerInvoiceId])
  @@index([providerInvoicePaymentId])
  @@index([providerChargeId])
  @@index([providerPaymentIntentId])
  @@index([status, startsAt])
  @@map("billing_period")
}

model PaymentEvent {
  id                      String                @id @default(cuid())
  provider                String
  providerEventId         String
  normalizedTransactionId String?
  verifiedAt              DateTime              @db.Timestamptz(3)
  receivedAt              DateTime              @default(now()) @db.Timestamptz(3)
  envelope                Json
  status                  EventProcessingStatus @default(RECEIVED)
  processedAt             DateTime?             @db.Timestamptz(3)
  failureReason           String?
  attemptCount            Int                   @default(0)
  lastTriggerAttempt      Int?
  lastAttemptAt           DateTime?             @db.Timestamptz(3)
  lastTriggerRunId        String?
  lastErrorClass          String?
  processingToken         String?               @unique
  processingLeasedUntil   DateTime?             @db.Timestamptz(3)
  stripeRefundReceipts    StripeRefundReceipt[]

  @@unique([provider, providerEventId])
  @@index([provider, normalizedTransactionId])
  @@index([status, receivedAt])
  @@index([processingLeasedUntil])
  @@map("payment_event")
}

model StripeRefund {
  id                      String                        @id @default(cuid())
  provider                String
  providerRefundId        String
  providerChargeId        String
  providerPaymentIntentId String?
  amount                  BigInt
  currency                String
  status                  StripeRefundStatus
  providerCreatedAt       DateTime                      @db.Timestamptz(3)
  lastProviderChangeAt    DateTime                      @db.Timestamptz(3)
  lastProviderChangeId    String
  finalizedCredits        BigInt                        @default(0)
  creditsFinalizedAt      DateTime?                     @db.Timestamptz(3)
  createdAt               DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                      @updatedAt @db.Timestamptz(3)
  receipts                StripeRefundReceipt[]
  repairAuthorities       StripeRefundRepairAuthority[]

  @@unique([provider, providerRefundId])
  @@index([provider, providerChargeId, status])
  @@index([status, creditsFinalizedAt])
  @@map("stripe_refund")
}

model StripeRefundRepairAuthority {
  id                            String                     @id @default(cuid())
  approvalKey                   String                     @unique
  refundId                      String
  refund                        StripeRefund               @relation(fields: [refundId], references: [id], onDelete: Restrict)
  issueId                       String
  issue                         StripeReconciliationIssue  @relation(fields: [issueId], references: [id], onDelete: Restrict)
  action                        StripeRefundRepairAction
  lifecycleStatus               StripeRefundStatus
  lifecycleLastProviderChangeId String
  lifecycleLastProviderChangeAt DateTime                   @db.Timestamptz(3)
  approvedCredits               BigInt
  ledgerFingerprint             String
  approvedByUserId              String
  reason                        String
  createdAt                     DateTime                   @default(now()) @db.Timestamptz(3)
  receipt                       StripeRefundRepairReceipt?

  @@unique([refundId, lifecycleLastProviderChangeId, ledgerFingerprint], map: "stripe_refund_repair_authority_refund_snapshot_key")
  @@index([issueId, createdAt])
  @@map("stripe_refund_repair_authority")
}

model StripeRefundRepairReceipt {
  id                 String                      @id @default(cuid())
  authorityId        String                      @unique
  authority          StripeRefundRepairAuthority @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  operationKey       String                      @unique
  appliedByUserId    String
  reason             String
  compensatedCredits BigInt                      @default(0)
  appliedAt          DateTime                    @default(now()) @db.Timestamptz(3)

  @@map("stripe_refund_repair_receipt")
}

model StripeRefundReceipt {
  id             String       @id @default(cuid())
  refundId       String
  refund         StripeRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  paymentEventId String       @unique
  paymentEvent   PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([refundId, paymentEventId])
  @@index([refundId, createdAt])
  @@map("stripe_refund_receipt")
}

model StripeReconciliationCheckpoint {
  id                   String                     @id
  provider             String                     @unique
  status               StripeReconciliationStatus @default(IDLE)
  sweepId              String?
  sweepCutoff          DateTime?                  @db.Timestamptz(3)
  stage                StripeReconciliationStage  @default(SUBSCRIPTIONS)
  cursor               String?
  leaseToken           String?                    @unique
  leasedUntil          DateTime?                  @db.Timestamptz(3)
  pagesProcessed       Int                        @default(0)
  continuationSequence Int                        @default(0)
  failureCount         Int                        @default(0)
  lastAttemptAt        DateTime?                  @db.Timestamptz(3)
  lastCompletedAt      DateTime?                  @db.Timestamptz(3)
  lastErrorCode        String?
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([status, leasedUntil])
  @@map("stripe_reconciliation_checkpoint")
}

model StripeReconciliationIssue {
  id                String                          @id @default(cuid())
  issueKey          String                          @unique
  provider          String
  sweepId           String
  stage             StripeReconciliationStage
  code              String
  entityType        String
  providerObjectId  String
  status            StripeReconciliationIssueStatus @default(OPEN)
  details           Json
  occurrences       Int                             @default(1)
  firstSeenAt       DateTime                        @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime                        @default(now()) @db.Timestamptz(3)
  resolvedAt        DateTime?                       @db.Timestamptz(3)
  repairAuthorities StripeRefundRepairAuthority[]

  @@index([status, lastSeenAt])
  @@index([provider, providerObjectId])
  @@map("stripe_reconciliation_issue")
}

model RuntimeConfigOverride {
  id               String    @id @default(cuid())
  configKey        String
  version          Int       @unique
  value            Json
  active           Boolean   @default(true)
  reason           String
  createdByUserId  String
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  revertedAt       DateTime? @db.Timestamptz(3)
  revertedByUserId String?

  @@unique([configKey, version])
  @@index([configKey, active, version])
  @@map("runtime_config_override")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  metadata    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  action      String
  subjectHash String
  windowStart DateTime @db.Timestamptz(3)
  windowEnd   DateTime @db.Timestamptz(3)
  /// @zod.custom.use(z.bigint().default(BigInt(0)))
  count       BigInt   @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([action, subjectHash, windowStart])
  @@index([windowEnd])
  @@map("rate_limit_bucket")
}

model GenerationDraft {
  id                String                 @id @default(cuid())
  ownerType         OwnerType
  ownerId           String
  submittedByUserId String
  claimTokenHash    String                 @unique
  assetId           String?
  productKey        String?
  inputSnapshot     Json
  status            GenerationDraftStatus  @default(ACTIVE)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  expiresAt         DateTime               @db.Timestamptz(3)
  guestBootstrap    GuestSessionBootstrap?

  @@index([ownerType, ownerId, updatedAt, id])
  @@index([status, expiresAt])
  @@index([assetId])
  @@map("generation_draft")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}
