{
	"name": "@repo/database",
	"version": "0.0.0",
	"main": "./index.ts",
	"types": "./**/.tsx",
	"imports": {
		"#prisma-runtime-client": {
			"workerd": "./prisma/generated-worker/client.ts",
			"default": "./prisma/generated/client.ts"
		}
	},
	"exports": {
		".": "./index.ts",
		"./client": "./prisma/client.ts",
		"./media-assets": "./prisma/queries/media/assets.ts",
		"./media-job-status": "./prisma/queries/media/job-status.ts",
		"./media-quotes": "./prisma/queries/media/quotes.ts",
		"./video-v1": "./prisma/queries/media/video-v1.ts",
		"./video-v1-execution": "./prisma/queries/media/video-v1-execution.ts",
		"./video-v1-moderation-events": "./prisma/queries/media/video-v1-moderation-events.ts",
		"./video-v1-seeapi-events": "./prisma/queries/media/video-v1-seeapi-events.ts",
		"./video-v1-fulfillment": "./prisma/queries/media/video-v1-fulfillment.ts",
		"./video-v1-recovery": "./prisma/queries/media/video-v1-recovery.ts",
		"./video-v1-uploads": "./prisma/queries/media/video-v1-uploads.ts",
		"./generated-client": {
			"workerd": "./prisma/generated-worker/client.ts",
			"default": "./prisma/generated/client.ts"
		},
		"./video-v1-cleanup": "./prisma/queries/media/video-v1-cleanup.ts"
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"generate": "dotenv -c -e ../../.env -- prisma generate --no-hints",
		"push": "dotenv -c -e ../../.env -- prisma db push",
		"migrate": "dotenv -c -e ../../.env -- prisma migrate dev",
		"studio": "dotenv -c -e ../../.env -- prisma studio",
		"type-check": "tsc --noEmit",
		"test": "vitest run prisma/client.test.ts prisma/queries/media/state-machine.test.ts prisma/queries/media/assets-transactions.test.ts prisma/queries/media/guest-admission.test.ts prisma/queries/media/guest-initial-activation.test.ts shared/checkout-recovery.test.ts --configLoader runner",
		"test:integration": "vitest run --config vitest.integration.config.ts --configLoader runner"
	},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-pg": "catalog:",
		"@prisma/client": "catalog:",
		"@repo/config": "workspace:*",
		"drizzle-orm": "catalog:",
		"drizzle-zod": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "8.23.1",
		"dotenv": "catalog:",
		"dotenv-cli": "catalog:",
		"drizzle-kit": "catalog:",
		"prisma": "catalog:",
		"prisma-zod-generator": "catalog:",
		"vitest": "catalog:"
	}
}
