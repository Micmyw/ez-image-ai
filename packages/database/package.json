{
	"name": "@repo/database",
	"version": "0.0.0",
	"main": "./index.ts",
	"types": "./**/.tsx",
	"exports": {
		".": "./index.ts",
		"./client": "./prisma/client.ts",
		"./media-assets": "./prisma/queries/media/assets.ts",
		"./media-quotes": "./prisma/queries/media/quotes.ts",
		"./generated-client": "./prisma/generated/client.ts"
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"generate": "dotenv -c -e ../../.env -- prisma generate --no-hints",
		"push": "dotenv -c -e ../../.env -- prisma db push",
		"migrate": "dotenv -c -e ../../.env -- prisma migrate dev",
		"studio": "dotenv -c -e ../../.env -- prisma studio",
		"type-check": "tsc --noEmit",
		"test": "vitest run prisma/queries/media/state-machine.test.ts prisma/queries/media/assets-transactions.test.ts --configLoader runner",
		"test:integration": "vitest run --config vitest.integration.config.ts --configLoader runner"
	},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-pg": "catalog:",
		"@prisma/client": "catalog:",
		"drizzle-orm": "catalog:",
		"drizzle-zod": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "8.20.0",
		"dotenv": "catalog:",
		"dotenv-cli": "catalog:",
		"drizzle-kit": "catalog:",
		"prisma": "catalog:",
		"prisma-zod-generator": "catalog:",
		"vitest": "catalog:"
	}
}
