@@ -0,0 +1,629 @@
+"use strict";
+
+// Compiler and bounded single-read template reuse for the pinned edge runtime.
+// Never retain scopes, evaluated arguments, results, executors or connections.
+const states = new WeakMap();
+const planProvenance = new WeakMap();
+const facadeOwners = new WeakMap();
+const namespaceSources = new WeakMap();
+const namespaceTokens = new WeakSet();
+const readActions = new Set([
+	"findUnique",
+	"findUniqueOrThrow",
+	"findFirst",
+	"findFirstOrThrow",
+	"findMany",
+]);
+const MAX_PLAN_ENTRIES = 256;
+const MAX_PLAN_BYTES = 2 * 1024 * 1024;
+const MAX_PLAN_ENTRY_BYTES = 128 * 1024;
+// A WeakMap value is not a sufficient GC root after a WASM panic. Retain only
+// records present at the first failure or the first later hard escalation
+// (including synchronous constructors already in progress), so their
+// wasm-bindgen finalizers cannot run later. Later independent clients are not
+// accumulated in these bounded failure snapshots.
+const quarantines = new Set();
+const validationCodes = new Set(["P2009", "P2012", "P2013", "P2014", "P2019"]);
+const validationKinds = new Set([
+	"EmptySelection",
+	"InvalidArgumentType",
+	"InvalidArgumentValue",
+	"SomeFieldsMissing",
+	"TooManyFieldsGiven",
+	"SelectionSetOnScalar",
+	"RequiredArgumentMissing",
+	"Union",
+	"UnknownArgument",
+	"UnknownInputField",
+	"UnknownSelectionField",
+	"ValueTooLarge",
+]);
+const own = (value, key) => Object.prototype.hasOwnProperty.call(value, key);
+
+// Validate once, before serialization: JSON must not silently erase or evaluate
+// unsupported compiler values. Unfamiliar plans retain their original protocol.
+function serializedData(value, maximum = MAX_PLAN_ENTRY_BYTES / 2) {
+	try {
+		const seen = new Set();
+		let units = 0;
+		function visit(item, depth) {
+			if (depth > 64 || seen.size > 20000 || units > maximum) throw 0;
+			if (item === null || typeof item === "boolean") return;
+			if (typeof item === "string") {
+				units += item.length;
+				return;
+			}
+			if (typeof item === "number" && Number.isFinite(item) && !Object.is(item, -0)) return;
+			if (typeof item !== "object" || seen.has(item)) throw 0;
+			const array = Array.isArray(item);
+			if (Object.getPrototypeOf(item) !== (array ? Array.prototype : Object.prototype)) throw 0;
+			if (own(Object.prototype, "toJSON") || (array && own(Array.prototype, "toJSON"))) throw 0;
+			const descriptors = Object.getOwnPropertyDescriptors(item);
+			const keys = Reflect.ownKeys(descriptors);
+			if (array && (keys.length !== item.length + 1 || !own(descriptors, "length"))) throw 0;
+			seen.add(item);
+			for (const key of keys) {
+				if (array && key === "length") continue;
+				if (typeof key !== "string") throw 0;
+				const descriptor = descriptors[key];
+				if (!own(descriptor, "value") || !descriptor.enumerable) throw 0;
+				if (array && (!/^(0|[1-9]\d*)$/.test(key) || Number(key) >= item.length)) throw 0;
+				units += key.length;
+				visit(descriptor.value, depth + 1);
+			}
+		}
+		visit(value, 0);
+		if (units > maximum) return null;
+		const serialized = JSON.stringify(value);
+		return typeof serialized === "string" && serialized.length <= maximum
+			? { serialized, nodes: seen }
+			: null;
+	} catch {
+		return null;
+	}
+}
+
+// Capture exactly the metadata used to construct this engine's ParamGraph.
+// Native strings are compared directly; no per-query schema hashing/encoding.
+function captureQueryPlanNamespace(schema, enums) {
+	try {
+		const enumData = serializedData(enums);
+		if (!enumData) return undefined;
+		const cached = namespaceSources.get(schema);
+		// The edge ParamGraph cache supplies its existing private dictionary
+		// snapshot, frozen after its source mutation guards have run. Reuse that
+		// validated snapshot instead of rescanning the whole schema per client.
+		if (cached?.immutable) {
+			if (cached.bytes + enumData.serialized.length * 2 > MAX_PLAN_BYTES) return undefined;
+			if (cached.enums === enumData.serialized) return cached;
+			const token = Object.freeze({ ...cached, enums: enumData.serialized });
+			namespaceSources.set(schema, token);
+			namespaceTokens.add(token);
+			return token;
+		}
+		const props = dataProperties(schema, ["graph", "strings"], ["graph", "strings"]);
+		if (!props || typeof props.graph.value !== "string") return undefined;
+		const strings = props.strings.value;
+		if (!Array.isArray(strings) || Object.getPrototypeOf(strings) !== Array.prototype)
+			return undefined;
+		const descriptors = Object.getOwnPropertyDescriptors(strings);
+		if (Reflect.ownKeys(descriptors).length !== strings.length + 1 || strings.length > 20000)
+			return undefined;
+		const values = [];
+		let bytes = props.graph.value.length * 2;
+		for (let index = 0; index < strings.length; index++) {
+			const descriptor = descriptors[index];
+			if (
+				!descriptor ||
+				!own(descriptor, "value") ||
+				!descriptor.enumerable ||
+				typeof descriptor.value !== "string"
+			)
+				return undefined;
+			values.push(descriptor.value);
+			bytes += descriptor.value.length * 2;
+		}
+		if (bytes + enumData.serialized.length * 2 > MAX_PLAN_BYTES) return undefined;
+		if (
+			cached &&
+			cached.graph === props.graph.value &&
+			cached.enums === enumData.serialized &&
+			cached.strings.length === values.length &&
+			cached.strings.every((value, index) => value === values[index])
+		)
+			return cached;
+		const token = Object.freeze({
+			graph: props.graph.value,
+			strings: Object.freeze(values),
+			enums: enumData.serialized,
+			bytes,
+			immutable: Object.isFrozen(schema) && Object.isFrozen(strings),
+		});
+		namespaceSources.set(schema, token);
+		namespaceTokens.add(token);
+		return token;
+	} catch {
+		return undefined;
+	}
+}
+
+function sameNamespace(left, right) {
+	return (
+		left === right ||
+		(left.graph === right.graph &&
+			left.enums === right.enums &&
+			left.strings.length === right.strings.length &&
+			left.strings.every((value, index) => value === right.strings[index]))
+	);
+}
+
+function clearPlans(cache) {
+	if (!cache) return;
+	for (const handle of cache.entries.values()) handle.serialized = undefined;
+	cache.entries.clear();
+	cache.bytes = 0;
+}
+
+function livePlan(owner) {
+	return (
+		!owner.closed &&
+		!owner.state.disabled &&
+		owner.epoch === owner.state.epoch &&
+		owner.state.slot?.planCache === owner.cache &&
+		!owner.state.slot.busy
+	);
+}
+
+function isQueryPlanReusable(compiler, plan) {
+	const owner = facadeOwners.get(compiler);
+	// Native getSingle also contains unsupported/oversized plans. A later
+	// explicit request must consult the original facade after its shared epoch
+	// closes, even when that particular plan never entered our template LRU.
+	if (
+		owner &&
+		(owner.closed ||
+			owner.state.disabled ||
+			owner.epoch !== owner.state.epoch ||
+			owner.state.slot?.busy)
+	)
+		return false;
+	const tracked = planProvenance.get(plan);
+	return !tracked || (owner === tracked.owner && livePlan(tracked.owner));
+}
+
+// Called after the single request's complete argument object (including
+// customFetch hooks) has been evaluated, immediately before executor handoff.
+function prepareQueryPlanForExecution(compiler, request) {
+	const tracked = planProvenance.get(request.plan);
+	if (!tracked) return request;
+	if (facadeOwners.get(compiler) !== tracked.owner || !livePlan(tracked.owner)) throw unavailable();
+	const plan = JSON.parse(tracked.handle.serialized ?? JSON.stringify(request.plan));
+	if (!livePlan(tracked.owner)) throw unavailable();
+	return { ...request, plan };
+}
+
+function eligibleRead(request) {
+	if (typeof request !== "string" || request.length * 2 >= MAX_PLAN_ENTRY_BYTES) return false;
+	try {
+		const query = JSON.parse(request);
+		return query && typeof query.modelName === "string" && readActions.has(query.action);
+	} catch {
+		return false;
+	}
+}
+
+function rememberPlan(cache, key, data) {
+	const bytes = 2 * (key.length + data.serialized.length);
+	if (bytes > MAX_PLAN_ENTRY_BYTES) return undefined;
+	while (cache.entries.size >= MAX_PLAN_ENTRIES || cache.bytes + bytes > MAX_PLAN_BYTES) {
+		const oldest = cache.entries.keys().next().value;
+		if (oldest === undefined) break;
+		const removed = cache.entries.get(oldest);
+		cache.bytes -= removed.bytes;
+		removed.serialized = undefined;
+		cache.entries.delete(oldest);
+	}
+	const handle = { serialized: data.serialized, bytes };
+	cache.entries.set(key, handle);
+	cache.bytes += bytes;
+	return handle;
+}
+
+function markPlan(plan, owner, handle, nodes) {
+	if (nodes) for (const node of nodes) Object.freeze(node);
+	else {
+		const freeze = (node) => {
+			if (node && typeof node === "object") {
+				for (const child of Object.values(node)) freeze(child);
+				Object.freeze(node);
+			}
+		};
+		freeze(plan);
+	}
+	planProvenance.set(plan, { owner, handle });
+	return plan;
+}
+
+function dataProperties(value, allowed, required) {
+	if (value === null || typeof value !== "object") return null;
+	const prototype = Object.getPrototypeOf(value);
+	if (prototype !== Object.prototype && prototype !== null) return null;
+	const descriptors = Object.getOwnPropertyDescriptors(value);
+	const keys = Reflect.ownKeys(descriptors);
+	if (keys.some((key) => typeof key !== "string" || !allowed.includes(key))) return null;
+	if (required.some((key) => !own(descriptors, key))) return null;
+	if (keys.some((key) => !own(descriptors[key], "value"))) return null;
+	return descriptors;
+}
+
+function exactKey(options) {
+	try {
+		const props = dataProperties(
+			options,
+			["datamodel", "provider", "connectionInfo"],
+			["datamodel", "provider", "connectionInfo"],
+		);
+		if (
+			!props ||
+			typeof props.datamodel.value !== "string" ||
+			typeof props.provider.value !== "string"
+		)
+			return null;
+		const info = dataProperties(
+			props.connectionInfo.value,
+			["schemaName", "maxBindValues", "supportsRelationJoins"],
+			["supportsRelationJoins"],
+		);
+		if (!info || typeof info.supportsRelationJoins.value !== "boolean") return null;
+		const schemaName = info.schemaName?.value;
+		const maxBindValues = info.maxBindValues?.value;
+		if (schemaName !== undefined && typeof schemaName !== "string") return null;
+		if (
+			maxBindValues !== undefined &&
+			(!Number.isInteger(maxBindValues) || maxBindValues < 0 || maxBindValues > 0xffffffff)
+		)
+			return null;
+		return {
+			datamodel: props.datamodel.value,
+			provider: props.provider.value,
+			hasSchemaName: own(info, "schemaName"),
+			schemaName,
+			hasMaxBindValues: own(info, "maxBindValues"),
+			maxBindValues,
+			supportsRelationJoins: info.supportsRelationJoins.value,
+		};
+	} catch {
+		// Accessors, proxies and unfamiliar options take the unmodified constructor
+		// path; cache inspection must not replace its own validation/error contract.
+		return null;
+	}
+}
+
+function sameKey(left, right) {
+	return (
+		left.datamodel === right.datamodel &&
+		left.provider === right.provider &&
+		left.hasSchemaName === right.hasSchemaName &&
+		left.schemaName === right.schemaName &&
+		left.hasMaxBindValues === right.hasMaxBindValues &&
+		left.maxBindValues === right.maxBindValues &&
+		left.supportsRelationJoins === right.supportsRelationJoins
+	);
+}
+
+function keyOptions(key) {
+	const connectionInfo = { supportsRelationJoins: key.supportsRelationJoins };
+	if (key.hasSchemaName) connectionInfo.schemaName = key.schemaName;
+	if (key.hasMaxBindValues) connectionInfo.maxBindValues = key.maxBindValues;
+	return { datamodel: key.datamodel, provider: key.provider, connectionInfo };
+}
+
+function knownValidationError(error) {
+	try {
+		const props = dataProperties(error, ["message", "code", "meta"], ["message", "code", "meta"]);
+		if (!props || typeof props.message.value !== "string" || !validationCodes.has(props.code.value))
+			return false;
+		if (props.code.value !== "P2009") return true;
+		const meta = props.meta.value;
+		if (meta === null || typeof meta !== "object") return false;
+		const kind = Object.getOwnPropertyDescriptor(meta, "kind");
+		return !!kind && own(kind, "value") && validationKinds.has(kind.value);
+	} catch {
+		return false;
+	}
+}
+
+function disable(state, hard) {
+	if (!state.disabled || (hard && !state.hard)) {
+		state.disabled = true;
+		state.hard = hard;
+		state.epoch++;
+		clearPlans(state.slot?.planCache);
+		const retained = new Set(state.active);
+		if (state.slot) retained.add(state.slot.record);
+		for (const record of retained) record.quarantined = true;
+		quarantines.add(retained);
+		state.slot = undefined;
+	}
+}
+
+function hardDisableQueryCompilerReuse(Constructor) {
+	const state = states.get(Constructor);
+	if (state) disable(state, true);
+}
+
+function unavailable() {
+	return new Error("QUERY_COMPILER_REUSE_DISABLED");
+}
+
+function construct(state, Constructor, options) {
+	const record = {
+		compiler: undefined,
+		quarantined: false,
+		activeCalls: 0,
+		disposeRequested: false,
+		disposed: false,
+	};
+	state.active.add(record);
+	try {
+		record.compiler = new Constructor(options);
+		// A nested call may have invalidated the same constructor while this
+		// constructor was running. Its token was already rooted by disable().
+		if (record.quarantined) throw unavailable();
+		return record;
+	} catch (error) {
+		disable(state, true);
+		throw error;
+	} finally {
+		state.active.delete(record);
+	}
+}
+
+function invoke(state, record, method, request) {
+	if (record.quarantined) throw unavailable();
+	if (record.disposed) throw new Error("QUERY_COMPILER_FACADE_CLOSED");
+	// Once reuse is disabled, independent owners keep the original lifecycle;
+	// do not accumulate new objects in the quarantine of an earlier failure.
+	record.activeCalls++;
+	if (!state.hard) state.active.add(record);
+	let result;
+	let failed = false;
+	let failure;
+	try {
+		result = record.compiler[method](request);
+		if (record.quarantined && state.hard) throw unavailable();
+	} catch (error) {
+		disable(state, !knownValidationError(error));
+		failed = true;
+		failure = error;
+	} finally {
+		record.activeCalls--;
+		if (record.activeCalls === 0) state.active.delete(record);
+	}
+	if (record.activeCalls === 0 && record.disposeRequested) {
+		try {
+			dispose(state, record);
+		} catch (error) {
+			// Cleanup must never hide the original failed compile or retry it.
+			if (!failed) {
+				failed = true;
+				failure = error;
+			}
+		}
+	}
+	if (!failed && record.quarantined && state.hard) throw unavailable();
+	if (failed) throw failure;
+	return result;
+}
+
+function dispose(state, record) {
+	record.disposeRequested = true;
+	if (record.quarantined || record.activeCalls > 0 || record.disposed) return;
+	record.disposed = true;
+	const tracked = !state.hard;
+	if (tracked) state.active.add(record);
+	try {
+		record.compiler.free();
+		if (!record.quarantined) record.compiler = undefined;
+	} catch (error) {
+		disable(state, true);
+		throw error;
+	} finally {
+		if (tracked) state.active.delete(record);
+	}
+}
+
+function independentFacade(state, record) {
+	let closed = false;
+	function call(method, request) {
+		if (closed) throw new Error("QUERY_COMPILER_FACADE_CLOSED");
+		return invoke(state, record, method, request);
+	}
+	return {
+		compile: (request) => call("compile", request),
+		compileBatch: (request) => call("compileBatch", request),
+		free() {
+			if (closed) return;
+			closed = true;
+			dispose(state, record);
+		},
+	};
+}
+
+function cachedFacade(state, Constructor, key, transformInitError, namespace) {
+	let closed = false;
+	let cache;
+	if (namespaceTokens.has(namespace)) {
+		const existing = state.slot.planCache;
+		if (!existing) cache = state.slot.planCache = { namespace, entries: new Map(), bytes: 0 };
+		else if (sameNamespace(existing.namespace, namespace)) cache = existing;
+	}
+	const owner = { state, epoch: state.epoch, cache, closed: false };
+	let privateRecord;
+	let privateInitializing = false;
+	function newPrivateRecord() {
+		try {
+			// This is a later, independently requested compile, never a retry of the
+			// call that disabled reuse. Preserve initialization error metadata.
+			return construct(state, Constructor, keyOptions(key));
+		} catch (error) {
+			disable(state, true);
+			throw transformInitError(error);
+		}
+	}
+	function temporaryCall(method, request) {
+		if (state.hard) throw unavailable();
+		let temporary;
+		try {
+			temporary = construct(state, Constructor, keyOptions(key));
+		} catch (error) {
+			throw transformInitError(error);
+		}
+		if (closed) {
+			dispose(state, temporary);
+			throw new Error("QUERY_COMPILER_FACADE_CLOSED");
+		}
+		const result = invoke(state, temporary, method, request);
+		dispose(state, temporary);
+		if (temporary.quarantined && state.hard) throw unavailable();
+		return result;
+	}
+	function call(method, request) {
+		if (closed) throw new Error("QUERY_COMPILER_FACADE_CLOSED");
+		if (privateRecord) {
+			if (privateRecord.activeCalls > 0) return temporaryCall(method, request);
+			return invoke(state, privateRecord, method, request);
+		}
+		if (state.disabled) {
+			if (state.hard) throw unavailable();
+			if (privateInitializing) return temporaryCall(method, request);
+			let record;
+			privateInitializing = true;
+			try {
+				record = newPrivateRecord();
+			} finally {
+				privateInitializing = false;
+			}
+			if (closed) {
+				dispose(state, record);
+				throw new Error("QUERY_COMPILER_FACADE_CLOSED");
+			}
+			privateRecord = record;
+			return invoke(state, privateRecord, method, request);
+		}
+		const slot = state.slot;
+		if (!slot || !sameKey(slot.key, key)) throw unavailable();
+		if (slot.busy) {
+			// Synchronous reentry never waits for another borrower. The temporary
+			// object has one owner and is not added to the reusable slot.
+			return temporaryCall(method, request);
+		}
+		const share = cache && method === "compile" && eligibleRead(request);
+		if (share) {
+			const handle = cache.entries.get(request);
+			if (handle) {
+				cache.entries.delete(request);
+				cache.entries.set(request, handle);
+				return markPlan(JSON.parse(handle.serialized), owner, handle);
+			}
+		}
+		slot.busy = true;
+		const epoch = state.epoch;
+		try {
+			const result = invoke(state, slot.record, method, request);
+			if (!share || result === null || typeof result !== "object") return result;
+			const data = serializedData(result);
+			if (closed || state.disabled || epoch !== state.epoch || state.slot !== slot)
+				throw unavailable();
+			if (!data) return result;
+			const handle = rememberPlan(cache, request, data);
+			return handle ? markPlan(JSON.parse(data.serialized), owner, handle) : result;
+		} finally {
+			// A nested failure permanently detaches the slot; never revive it.
+			if (!state.disabled && state.epoch === epoch) slot.busy = false;
+		}
+	}
+	const facade = {
+		compile: (request) => call("compile", request),
+		compileBatch: (request) => call("compileBatch", request),
+		free() {
+			if (closed) return;
+			closed = true;
+			owner.closed = true;
+			if (privateRecord) dispose(state, privateRecord);
+		},
+	};
+	facadeOwners.set(facade, owner);
+	return facade;
+}
+
+function createReusableQueryCompiler(
+	Constructor,
+	options,
+	transformInitError = (error) => error,
+	namespace,
+) {
+	let state = states.get(Constructor);
+	if (!state) {
+		state = {
+			disabled: false,
+			hard: false,
+			epoch: 0,
+			slot: undefined,
+			creating: false,
+			active: new Set(),
+		};
+		states.set(Constructor, state);
+	}
+	if (state.disabled) {
+		try {
+			return new Constructor(options);
+		} catch (error) {
+			disable(state, true);
+			throw error;
+		}
+	}
+	const key = exactKey(options);
+	// Reflecting on an unfamiliar proxy can reenter user code. A failure in that
+	// nested call must not let this already-started factory publish a new slot.
+	if (state.disabled) {
+		try {
+			return new Constructor(options);
+		} catch (error) {
+			disable(state, true);
+			throw error;
+		}
+	}
+	if (
+		!key ||
+		state.creating ||
+		(state.slot && (!sameKey(state.slot.key, key) || state.slot.busy))
+	) {
+		return independentFacade(state, construct(state, Constructor, options));
+	}
+	if (!state.slot) {
+		state.creating = true;
+		try {
+			const record = construct(state, Constructor, options);
+			state.active.add(record);
+			try {
+				const after = exactKey(options);
+				if (record.quarantined || state.disabled) throw unavailable();
+				// Keep unfamiliar/mutated constructor inputs on their independent path.
+				if (!after || !sameKey(key, after)) return independentFacade(state, record);
+				state.slot = { key, record, busy: false };
+			} finally {
+				state.active.delete(record);
+			}
+		} finally {
+			state.creating = false;
+		}
+	}
+	return cachedFacade(state, Constructor, key, transformInitError, namespace);
+}
+
+exports.createReusableQueryCompiler = createReusableQueryCompiler;
+exports.hardDisableQueryCompilerReuse = hardDisableQueryCompilerReuse;
+exports.captureQueryPlanNamespace = captureQueryPlanNamespace;
+exports.isQueryPlanReusable = isQueryPlanReusable;
+exports.prepareQueryPlanForExecution = prepareQueryPlanForExecution;
