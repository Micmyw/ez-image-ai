{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ezpic-workflows",
	"account_id": "44c8c5cb3ce2004d398ff271836bdd2e",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"limits": { "cpu_ms": 30000 },
	"triggers": { "crons": ["* * * * *"] },
	"vars": {
		"VIDEO_V1_ENABLED": "false",
		"EZPIC_RUNTIME": "workers",
		"EZPIC_DATABASE_BINDING": "hyperdrive"
	},
	"images": { "binding": "IMAGES" },
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
	"r2_buckets": [{ "binding": "VIDEO_MEDIA_BUCKET", "bucket_name": "ezpic-media-local" }],
	"workflows": [
		{ "name": "ezpic-jobs", "binding": "JOBS", "class_name": "JobsWorkflow" },
		{
			"name": "ezpic-video-v1-hybrid-local",
			"binding": "VIDEO_WORKFLOW",
			"class_name": "VideoGenerationWorkflowV1"
		}
	],
	"containers": [
		{
			"class_name": "JobsContainer",
			"image": "../jobs-runtime/Dockerfile",
			"image_build_context": "../..",
			"instance_type": "basic",
			"max_instances": 1
		}
	],
	"durable_objects": { "bindings": [{ "name": "JOBS_RUNTIME", "class_name": "JobsContainer" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobsContainer"] }],
	"env": {
		"staging": {
			"name": "ezpic-workflows-staging",
			"workflows": [
				{ "name": "ezpic-jobs-staging", "binding": "JOBS", "class_name": "JobsWorkflow" },
				{
					"name": "ezpic-video-v1-hybrid-staging",
					"binding": "VIDEO_WORKFLOW",
					"class_name": "VideoGenerationWorkflowV1"
				}
			],
			"containers": [
				{
					"class_name": "JobsContainer",
					"image": "../jobs-runtime/Dockerfile",
					"image_build_context": "../..",
					"instance_type": "basic",
					"max_instances": 1
				}
			],
			"durable_objects": { "bindings": [{ "name": "JOBS_RUNTIME", "class_name": "JobsContainer" }] }
		},
		"production": {
			"name": "ezpic-workflows-production",
			"workflows": [
				{ "name": "ezpic-jobs-production", "binding": "JOBS", "class_name": "JobsWorkflow" },
				{
					"name": "ezpic-video-v1-hybrid-production",
					"binding": "VIDEO_WORKFLOW",
					"class_name": "VideoGenerationWorkflowV1"
				}
			],
			"containers": [
				{
					"class_name": "JobsContainer",
					"image": "../jobs-runtime/Dockerfile",
					"image_build_context": "../..",
					"instance_type": "basic",
					"max_instances": 1
				}
			],
			"durable_objects": { "bindings": [{ "name": "JOBS_RUNTIME", "class_name": "JobsContainer" }] }
		}
	}
}
