{
	"name": "@repo/workflows",
	"private": true,
	"type": "module",
	"scripts": {
		"type-check": "tsc --noEmit --incremental false",
		"types": "wrangler types",
		"build": "wrangler deploy --dry-run --outdir dist",
		"build:workers": "wrangler deploy --config wrangler.workers.jsonc --dry-run --outdir dist-workers",
		"test:artifact:workerd": "node test-support/artifact-workerd-smoke.mjs",
		"test:admin-bots:workerd": "node --test test-support/admin-bot-environment.workerd.test.mjs",
		"test:runtime-lifetime:workerd": "node --test test-support/runtime-lifetime.workerd.test.mjs",
		"dev": "wrangler dev",
		"test": "vitest run"
	},
	"dependencies": {
		"@cloudflare/containers": "catalog:",
		"@repo/config": "workspace:*",
		"@repo/database": "workspace:*",
		"@repo/jobs": "workspace:*",
		"@repo/storage": "workspace:*",
		"@repo/utils": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.7",
		"@repo/ai": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
