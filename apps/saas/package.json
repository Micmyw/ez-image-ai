{
	"name": "saas",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"cloudflare:build": "node cloudflare/build.mjs",
		"cloudflare:preview": "opennextjs-cloudflare preview",
		"cloudflare:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
		"clean": "git clean -xdf .cache .turbo dist node_modules .next .content-collections .source",
		"dev": "next dev --port 3000",
		"e2e": "pnpm exec playwright test --ui",
		"e2e:ci": "pnpm exec playwright install && pnpm exec playwright test",
		"start": "next start",
		"generate": "fumadocs-mdx",
		"postinstall": "fumadocs-mdx",
		"test": "vitest run",
		"test:artifact:workerd": "node cloudflare/artifact-workerd-smoke.mjs",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "next typegen && fumadocs-mdx && tsc --noEmit --incremental false"
	},
	"dependencies": {
		"@ai-sdk/react": "catalog:",
		"@bprogress/next": "^3.2.12",
		"@hookform/resolvers": "catalog:",
		"@opennextjs/cloudflare": "catalog:",
		"@orpc/client": "catalog:",
		"@orpc/tanstack-query": "catalog:",
		"@prisma/nextjs-monorepo-workaround-plugin": "catalog:",
		"@repo/api": "workspace:*",
		"@repo/auth": "workspace:*",
		"@repo/config": "workspace:*",
		"@repo/database": "workspace:*",
		"@repo/i18n": "workspace:*",
		"@repo/logs": "workspace:*",
		"@repo/notifications": "workspace:*",
		"@repo/payments": "workspace:*",
		"@repo/storage": "workspace:*",
		"@repo/ui": "workspace:*",
		"@repo/utils": "workspace:*",
		"@sentry/nextjs": "10.70.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-table": "^8.21.3",
		"cropperjs": "catalog:",
		"fumadocs-core": "16.14.0",
		"fumadocs-mdx": "15.2.2",
		"fumadocs-ui": "16.14.0",
		"hono": "catalog:",
		"input-otp": "catalog:",
		"js-cookie": "catalog:",
		"lucide-react": "catalog:",
		"next": "catalog:",
		"next-intl": "catalog:",
		"next-themes": "catalog:",
		"nprogress": "catalog:",
		"nuqs": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-dropzone": "catalog:",
		"react-hook-form": "catalog:",
		"react-qr-code": "catalog:",
		"recharts": "catalog:",
		"server-only": "catalog:",
		"sharp": "catalog:",
		"streamdown": "catalog:",
		"ufo": "catalog:",
		"usehooks-ts": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@repo/auth": "workspace:*",
		"@repo/tailwind-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"@types/js-cookie": "catalog:",
		"@types/mdx": "catalog:",
		"@types/node": "catalog:",
		"@types/nprogress": "catalog:",
		"@types/pg": "^8.20.0",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"dotenv": "catalog:",
