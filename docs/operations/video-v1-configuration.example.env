# Documentation example only; do not copy secret values into version control.
# Deploying this closed configuration is not external acceptance or permission to charge.
VIDEO_V1_ENABLED=false
VIDEO_V1_ACCESS=internal
VIDEO_V1_ALLOWED_USER_IDS=
VIDEO_V1_OWNER_CONCURRENCY=1
VIDEO_V1_GLOBAL_CONCURRENCY=5
# Must reflect the account's actual SHARED Kie capacity; deliberately unset.
VIDEO_V1_PROVIDER_CONCURRENCY=
VIDEO_V1_PROVIDER_POLL_SECONDS=30
VIDEO_V1_PROVIDER_DEADLINE_SECONDS=1800
# Retained for SeeAPI input-image review; does not enable video output polling.
VIDEO_V1_MODERATION_POLL_SECONDS=30
# Also bounds the SeeAPI output callback wait before manual review.
VIDEO_V1_MODERATION_DEADLINE_SECONDS=1800
VIDEO_V1_MODEL_CONTRACT_VERSION=kie-kling-2.6-2026-10-04.1
# Legacy values retained for the original V1 rollout records.
VIDEO_V1_CREDITS=
VIDEO_V1_PRICE_VERSION=
VIDEO_V1_PRICING_BASIS=
VIDEO_V1_PROVIDER_COST_MICROS=
VIDEO_V1_MODERATION_COST_MICROS=
# Multi-model contract and request-specific full-cost pricing. Remain closed until verified.
VIDEO_MODEL_CONTRACT_VERSION=video-models-2026-10-04.1
# After approving actual account terms, set to kie-public-2026-10-04.1.
VIDEO_PRICE_ACCEPTED_VERSION=
VIDEO_PRICE_BASIS=
# Explicit ISO-8601 expiry for the approved cost basis.
VIDEO_PRICE_VALID_UNTIL=
# Cost profit target 110%; values <=10000 bps are rejected.
VIDEO_PRICE_MARKUP_BPS=11000
# USD micro-units. Fill actual conservative bounds, including minimum-plan allocation.
# Reapprove visual costs for the selected immutable policy before setting this marker.
# Required for the SeeAPI default: seeapi-video-policy-2026-10-04.1.
# Empty or mismatched values fail closed; retired-provider estimates are not accepted.
VIDEO_COST_VISUAL_POLICY_VERSION=
# Required after confirming the real Waffo prompt-review cost basis:
# waffo-prompt-safety-2026-10-04.1. Leave blank until approved; no invented price.
VIDEO_COST_TEXT_RULE_VERSION=
VIDEO_COST_MODERATION_BASE_MICROS=
VIDEO_COST_MODERATION_PER_SECOND_MICROS=
VIDEO_COST_RUNTIME_MICROS=
VIDEO_COST_STORAGE_MICROS=
VIDEO_COST_PAYMENT_FIXED_MICROS=
VIDEO_COST_PAYMENT_FEE_BPS=
VIDEO_COST_NONBILLABLE_FAILURE_BPS=
# Native model sound is preserved. New snapshots record audioSafetyPolicy.mode=not_requested.
# No audio-review service, credential or separate audio-review fee is configured.
VIDEO_V1_OUTPUT_ALLOWED_HOSTS=
# Prompt moderation uses Waffo; reference/output visuals use SeeAPI.
VIDEO_V1_TEXT_SAFETY_ADAPTER=waffo
VIDEO_V1_IMAGE_SAFETY_ADAPTER=seeapi
VIDEO_V1_VIDEO_SAFETY_ADAPTER=seeapi
# SeeAPI output: verified, persisted callback -> confirmation of the stored task ID.
# Maximum 3 GET requests total; retry only network/timeout/429/5xx with 1s then 3s backoff.
# The durable request budget/result survives duplicate callbacks and Workflow recovery.
# No callback -> zero GET; processing/invalid/rejection results are never polled again.
# Missing callback, exhausted/nonretryable failure or nonterminal result -> NEEDS_REVIEW.
# Those holds keep output unavailable and credits reserved for manual handling.
# There is no recurring output polling or automatic repeat POST/generation.
# Server-only URL HMAC secret: 32-512 printable ASCII non-space characters.
VIDEO_SEEAPI_CALLBACK_SECRET=
# Server-only JSON map of official whkey_ IDs to whsec_ signing secrets (1-8 entries).
# Keep blank until real account keys and signed inference delivery are verified.
SEEAPI_WEBHOOK_SIGNING_KEYS=
# Missing or invalid callback settings fail closed; never expose them in the catalog.
# Optional; if specified must equal canonical NEXT_PUBLIC_SAAS_URL HTTPS origin.
VIDEO_V1_CALLBACK_BASE_URL=
# Reuse existing private secrets: KIE_API_KEY, KIE_WEBHOOK_SECRET,
# SEEAPI_API_KEY (required for new reference/output visual moderation),
# WAFFO_MERCHANT_ID, WAFFO_PRIVATE_KEY (prompt review; preserve payment environment),
# BETTER_AUTH_SECRET and existing private R2 S3 credentials.
# Application-owned SeeAPI settings are snapshotted per job, not client parameters:
# threshold_offset=0, strict_special_care=true, return_frames=none;
# num_frames=clamp(ceil(requested duration in seconds)+2,8,32).
# Actual stored video must be <=30s and <=100000000 bytes.
# Sampling is not every-frame review; actual provider coverage remains NOT_RUN.
# Native deployment bindings: VIDEO_WORKFLOW, VIDEO_MEDIA_BUCKET, HYPERDRIVE,
# IMAGES (existing bounded image decoder/normalizer).
VIDEO_V1_UPLOAD_CORS_READY=false
# Set true only after confirming the private bucket's browser upload CORS.
# Existing MEDIA_GENERATION_ENABLED and runtime overrides also control admission.
